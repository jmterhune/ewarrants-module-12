        private void InitializeProperties()
        {
            DotNetNuke.Entities.Modules.ModuleController objModuleController = new DotNetNuke.Entities.Modules.ModuleController();
            DotNetNuke.Entities.Modules.ModuleInfo objModule = objModuleController.GetTabModule(TabModuleId);
            Hashtable tempValue = objModule.TabModuleSettings;
            AdminJudge = tempValue["AdminJudge"].ToString();
            if (tempValue["dRPO"] != null)
                RPO_DeSotoEmail = tempValue["dRPO"].ToString();
            if (tempValue["RPODirectory"] != null)
                RPO_Directory = tempValue["RPODirectory"].ToString();
            if (tempValue["mRPO"] != null)
                RPO_ManateeEmail = tempValue["mRPO"].ToString();
            if (tempValue["sRPO"] != null)
                RPO_SarasotaEmail = tempValue["sRPO"].ToString();
            if (tempValue["ccRPO"] != null)
                RPO_CC_Email = tempValue["ccRPO"].ToString();
            if (tempValue["DeSotoClerk"] != null)
                DeSotoClerkEmail = tempValue["DeSotoClerk"].ToString();
            if (tempValue["ManateeClerk"] != null)
                ManateeClerkEmail = tempValue["ManateeClerk"].ToString();
            if (tempValue["SarasotaClerk"] != null)
                SarasotaClerkEmail = tempValue["SarasotaClerk"].ToString();

            ModuleId = objModuleController.GetTabModule(TabModuleId).ModuleID;
        }

        private void SendRPOHearingNotifications(Warrant objWarrant, string fileName)
        {
            // InitializeProperties()
            string respondent = objWarrant.Defendant;
            UserInfo leoUser = UserController.Instance.GetUserById(PortalSettings.Current.PortalId, objWarrant.CreatedByUserID);
            string leo = leoUser.DisplayName;
            string agency = objWarrant.Agency.AgencyName;
            IEnumerable<string> emailList = null;
            string[] EmailString = Array.Empty<string>();
            if (!string.IsNullOrEmpty(RPO_CC_Email))
                EmailString = RPO_CC_Email.Split(new[] { ";" }, StringSplitOptions.RemoveEmptyEntries);

            switch (objWarrant.CountyName.ToLower())
            {
                case "manatee":
                    {
                        emailList = EmailString.Union(RPO_ManateeEmail.Split(new[] { ";" }, StringSplitOptions.RemoveEmptyEntries));
                        break;
                    }

                case "desoto":
                    {
                        emailList = EmailString.Union(RPO_DeSotoEmail.Split(new[] { ";" }, StringSplitOptions.RemoveEmptyEntries));
                        break;
                    }

                case "sarasota":
                    {
                        emailList = EmailString.Union(RPO_SarasotaEmail.Split(new[] { ";" }, StringSplitOptions.RemoveEmptyEntries));
                        break;
                    }
            }

            List<MailAttachment> emailAttach = new List<MailAttachment>();
            MailAttachment attach = new MailAttachment(fileName);
            emailAttach.Add(attach);
            string noreplyEmail = "webhelp@jud12.flcourts.org";
            string subject = "12th Circuit Court RPO Notification";
            string body = "<p><strong>Submitted By:</strong> " + leo + " from " + agency + " </p><p><strong>Respondent: </strong>" + respondent + Environment.NewLine + "</p><p>Approved RPO Attached</p>";
            try
            {
                string toAddress = string.Join(",", emailList);
                Mail.SendEmail(noreplyEmail, noreplyEmail, toAddress.Trim(), subject, body, emailAttach);
            }
            catch (Exception exc)
            {
                Exceptions.ProcessModuleLoadException(this, exc);
            }
        }

        private void SendRPORejectionNotifications(Warrant objWarrant, string reason)
        {
            // InitializeProperties()
            string respondent = objWarrant.Defendant;
            UserInfo leoUser = UserController.Instance.GetUserById(PortalSettings.Current.PortalId, objWarrant.CreatedByUserID);
            string leo = leoUser.DisplayName;
            string agency = objWarrant.Agency.AgencyName;
            IEnumerable<string> emailList = null;
            string[] EmailString = Array.Empty<string>();
            if (!string.IsNullOrEmpty(RPO_CC_Email))
                EmailString = RPO_CC_Email.Split(new[] { ";" }, StringSplitOptions.RemoveEmptyEntries);
            switch (objWarrant.CountyName.ToLower())
            {
                case "manatee":
                    {
                        emailList = EmailString.Union(RPO_ManateeEmail.Split(new[] { ";" }, StringSplitOptions.RemoveEmptyEntries));
                        break;
                    }

                case "desoto":
                    {
                        emailList = EmailString.Union(RPO_DeSotoEmail.Split(new[] { ";" }, StringSplitOptions.RemoveEmptyEntries));
                        break;
                    }

                case "sarasota":
                    {
                        emailList = EmailString.Union(RPO_SarasotaEmail.Split(new[] { ";" }, StringSplitOptions.RemoveEmptyEntries));
                        break;
                    }
            }
            List<MailAttachment> emailAttach = new List<MailAttachment>();
            string noreplyEmail = "webhelp@jud12.flcourts.org";
            string subject = "12th Circuit Court RPO Rejection Notification";
            string body = "<p><strong>The Proposed Order Submitted By:</strong> " + leo + " from " + agency + " reqarding <strong>Respondent: </strong>" + respondent + Environment.NewLine + "</p><p>Proposed Order was Rejected by Judge </p><p>Reason:" + reason + "</p>";
            try
            {
                string toAddress = string.Join(",", emailList);
                Mail.SendEmail(noreplyEmail, noreplyEmail, toAddress.Trim(), subject, body, emailAttach);
            }
            catch (Exception exc)
            {
                Exceptions.ProcessModuleLoadException(this, exc);
            }

        }


        private void DeleteDateStamp()
        {
            DirectoryInfo dir = new DirectoryInfo(MapPath("~/imagecache/"));
            FileInfo[] cacheFiles = dir.GetFiles(string.Format("{0}*.*", Session.SessionID));
            foreach (FileInfo file in cacheFiles)
            {
                try
                {
                    file.Delete();
                }
                catch (Exception)
                {
                }
            }
        }

        public static byte[] GetBytesForFile(string filePath)
        {
            byte[] fileByte;
            using (FileStream fileStream = System.IO.File.OpenRead(filePath))
            {
                fileByte = new byte[fileStream.Length - 1 + 1];
                fileStream.Read(fileByte, 0, (int)fileStream.Length);
            }

            return fileByte;
        }

        private void PrepareAnnotationLayers()
        {
            // We need to make sure that there are the same number of layers as pages
            int frameCount = WebThumbnailViewer1.Count;

            if (WebAnnotationViewer1.Annotations.Layers.Count != frameCount)
            {
                while (WebAnnotationViewer1.Annotations.Layers.Count < frameCount)
                    WebAnnotationViewer1.Annotations.Layers.Add(new LayerAnnotation());

                while (WebAnnotationViewer1.Annotations.Layers.Count > frameCount)
                    WebAnnotationViewer1.Annotations.Layers.RemoveAt(WebAnnotationViewer1.Annotations.Layers.Count - 1);

                WebAnnotationViewer1.UpdateAnnotations();
            }
        }

        public void Reorder(int DragIndex, int DropIndex)
        {
            // not really a swap. A remove and insert.
            string url = WebThumbnailViewer1.Url;
            string path = MapPath(url);
            PageManipulation.Reorder(path, DragIndex, DropIndex);
        }

        private void CancelCheckout(bool redirect)
        {
            try
            {
                var ctl = new WarrantController();
                Warrant objwarrant = ctl.GetWarrant(warrantId);
                if (objwarrant.Status == WarrantStatus.UnderReview)
                    objwarrant.Status = WarrantStatus.New;
                ctl.UpdateWarrant(objwarrant);
            }
            catch (Exception ex)
            {
                Exceptions.LogException(ex);
                Response.Redirect("/");
            }
        }

        private string GetIp()
        {
            string clientIp = Page.Request.ServerVariables["HTTP_X_FORWARDED_FOR"];
            if (!string.IsNullOrEmpty(clientIp))
            {
                string[] forwardedIps = clientIp.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
                clientIp = forwardedIps[forwardedIps.Length - 1];
            }
            else
                clientIp = Page.Request.ServerVariables["REMOTE_ADDR"];
            return clientIp;
        }

        protected void Page_Load(object sender, EventArgs e)
        {
            try
            {
                HttpContext.Current.Response.Cache.SetAllowResponseInBrowserHistory(false);
                HttpContext.Current.Response.Cache.SetNoStore();
                Response.Cache.SetExpires(DateTime.Now);
                Response.Cache.SetValidUntilExpires(true);
                Response.Cache.AppendCacheExtension("no-cache");
                Response.Expires = 0;
                string encryptedValue = "";
                if (Request.QueryString["enc"] != null)
                {
                    encryptedValue = Request.QueryString["enc"];
                    Int32.TryParse(encryptor.QueryStringDecode(encryptedValue, objUser.Username), out warrantId);
                }
                else
                    throw new ArgumentException("The Warrant File Could not be Retrieved from the Database");
                if (Request.QueryString["ModuleId"] != null)
                    TabModuleId = Int32.Parse(Request.QueryString["ModuleId"]);
                var sessionid = Session.SessionID;
                InitializeProperties();
                // Put user code to initialize the page here
                if (!IsPostBack)
                {
                    DeleteDateStamp();
                    var jCtl = new JudgeController();
                    Judge judge = jCtl.GetJudge(objUser.UserID, ModuleId);
                    UrlReferrer = Request.UrlReferrer.AbsoluteUri;
                    if (!string.IsNullOrEmpty(AdminJudge))
                    {
                        Int32.TryParse(encryptor.QueryStringDecode(judge.ApprovalKey, AdminJudge), out int judgeId);
                        if (objUser.UserID != judgeId)
                            Response.Redirect(UrlReferrer);
                    }
                    else
                    {
                        Response.Redirect(UrlReferrer);
                    }

                    if (warrantId > 0)
                    {
                        var ctl = new WarrantController();
                        Warrant objwarrant = ctl.GetWarrant(warrantId);
                        if (objwarrant != null)
                        {
                            if (objwarrant.WarrantType == WarrantType.RPO)
                            {
                                var aCtl = new AttachmentController();
                                _isRPO = 1;
                                attachments.Visible = true;
                                dateNormal.Visible = false;
                                dateRPO.Visible = true;
                                rptAttachments.DataSource = aCtl.GetAttachmentsByWarrant(warrantId);
                                rptAttachments.DataBind();
                            }

                            if (objwarrant.Status == WarrantStatus.Rejected)
                            {
                                container.Visible = false;
                                phMessage.Controls.Add(DotNetNuke.UI.Skins.Skin.GetModuleMessageControl("Notice", "The requested warrant has already been reviewed and rejected.  <a href='/eWarrants.aspx'>Return to the warrants list</a> and click the refresh link to update the warrants available for signing", DotNetNuke.UI.Skins.Controls.ModuleMessage.ModuleMessageType.BlueInfo));
                            }
                            if (objwarrant.Status == WarrantStatus.Signed)
                            {
                                container.Visible = false;
                                phMessage.Controls.Add(DotNetNuke.UI.Skins.Skin.GetModuleMessageControl("Notice", "The requested warrant has already been reviewed and signed.  <a href='/eWarrants.aspx'>Return to the warrants list</a> and click the refresh link to update the warrants available for signing", DotNetNuke.UI.Skins.Controls.ModuleMessage.ModuleMessageType.BlueInfo));
                            }
                            var lCtl = new LogController();
                            Log objLog = new Log
                            {
                                UserID = objUser.UserID,
                                EventTime = DateTime.Now,
                                EventDescription = "Viewed in Edit Mode",
                                WarrantID = objwarrant.WarrantID,
                                IP = GetIp()
                            };
                            lCtl.CreateLog(objLog);
                            ImageProcessing.AddPdfDecoder();
                            var fCtl = new FileController();
                            Components.File objwarrantFile = fCtl.GetFile(objwarrant.FileID);

                            if (objwarrantFile != null)
                            {
                                byte[] buffer = encryptor.DecryptStream(objwarrantFile.Bytes);
                                using (MemoryStream fileData = new MemoryStream(buffer))
                                {
                                    WebThumbnailViewer1.Open(fileData);
                                    PrepareAnnotationLayers();
                                    WebAnnotationViewer1.AutoZoom = AutoZoomMode.FitToWidth;
                                    WebThumbnailViewer1.SelectedIndex = 0;
                                }
                                int imageWidth = WebAnnotationViewer1.Image.Width;
                                InitializeDefaultAnnotations(judge, objUser.Username, imageWidth);
                            }
                            else
                                throw new ArgumentException("The Warrant File Could not be Retrieved from the Database");
                        }
                        else
                            throw new ArgumentException("Warrant Information Invalid");
                    }
                    else
                        throw new ArgumentException("Warrant Information Invalid");
                }
                if (hdtoCancel.Value == "false")
                {
                    WebAnnotationViewer1.ClearAnnotations();
                    CancelCheckout(false);
                }
            }
            catch (Exception ex)
            {
                phMessage.Controls.Add(DotNetNuke.UI.Skins.Skin.GetModuleMessageControl("Error", "An error has occurred processing the file.<br /> Refresh the Page and try again", DotNetNuke.UI.Skins.Controls.ModuleMessage.ModuleMessageType.RedError));
                Exceptions.LogException(ex);
                CancelCheckout(false);
            }
        }

        protected void WebThumbnailViewer1_ThumbnailDrop(object sender, Atalasoft.Imaging.WebControls.ThumbnailDropEventArgs e)
        {
            // Call me from the OnThumbnailDragDrop event of the WTV
            int dgi = e.DragIndex;
            int dpi = e.DropIndex;
            Reorder(dgi, dpi);
        }

        [RemoteInvokable]
        public string ApproveWarrant(string enc, string moduleId)
        {
            string returnString = "2|default";
            try
            {
                int frame = this.WebAnnotationViewer1.CurrentPage - 1;
                string url = this.WebAnnotationViewer1.ImageUrl;
                string path = MapPath(url);
                // This assumes that you used OpenUrl on a relative file path, with a frame index
                string imgPath = MapPath(WebAnnotationViewer1.ImageUrl);
                ImageProcessing.AddPdfDecoder();
                ImageInfo info = RegisteredDecoders.GetImageInfo(imgPath);
                if (objUser == null || string.IsNullOrEmpty(objUser.Username))
                {
                    returnString = "0|Your session has expired. Please log in and try again.";
                    return returnString;
                }
                Int32.TryParse(encryptor.QueryStringDecode(enc, objUser.Username), out warrantId);
                TabModuleId = Int32.Parse(moduleId);
                InitializeProperties();
                var ctl = new WarrantController();
                Warrant objwarrant = ctl.GetWarrant(warrantId);
                string warrantTypeName = "Warrant";
                if (objwarrant != null)
                {
                    objwarrant.Status = WarrantStatus.Signed;
                    objwarrant.ReviewedByJudgeUserID = objUser.UserID;
                    string warrantTitle = objwarrant.Title;
                    objwarrant.ReviewedDate = DateTime.Now;
                    ctl.UpdateWarrant(objwarrant);
                    if (info.FrameCount == WebAnnotationViewer1.Annotations.Layers.Count)
                    {
                        for (int fi = 0; fi <= info.FrameCount - 1; fi++)
                        {
                            using (AtalaImage page = new AtalaImage(imgPath, fi, null))
                            {

                                Annotations.BurnAnnotations(page, WebAnnotationViewer1.Annotations.Layers[fi].Items, path, fi);
                                WebAnnotationViewer1.Annotations.Layers[fi].Items.Clear();
                            }
                        }
                    }
                    WebAnnotationViewer1.ClearAnnotations();
                    byte[] unencryptedBytes = GetBytesForFile(path);
                    byte[] encryptedBytes = encryptor.EncryptStream(unencryptedBytes);
                    var fCtl = new FileController();
                    Components.File file = fCtl.GetFile(objwarrant.FileID);
                    file.Bytes = encryptedBytes;
                    fCtl.UpdateFile(file);
                    UserInfo leoUser = UserController.Instance.GetUserById(portal.PortalId, objwarrant.CreatedByUserID);
                    if (objwarrant.WarrantType == WarrantType.RPO)
                    {

                        try
                        {
                            warrantTypeName = "RPO";
                            string attachmentPath = @"C:\Websites\eWarrantAttachments\";
                            if (RPO_Directory != null)
                            {
                                attachmentPath = RPO_Directory;
                                if (!attachmentPath.EndsWith(@"\"))
                                    attachmentPath += @"\";
                            }
                            string fileName = attachmentPath + objwarrant.WarrantID.ToString() + "_rpo.pdf";
                            using (Stream fileStream = PageManipulation.GetPDFAttachment(objwarrant.Title, leoUser.DisplayName, file.UploadedDate, DateTime.Now, unencryptedBytes))
                            {
                                using (FileStream fs = new FileStream(fileName, FileMode.Create))
                                {
                                    fileStream.CopyTo(fs);
                                    fileStream.Close();
                                    fs.Close();
                                }
                            }
                            SendRPOHearingNotifications(objwarrant, fileName);
                        }
                        catch (Exception ex)
                        {
                            string message = "Failed to send RPO Notifications for Record ID: " + warrantId.ToString();
                            Mail.SendEmail("webhelp@jud12.flcourts.org", "webhelp@jud12.flcourts.org", "RPO Notification Error", message);
                            Exceptions.LogException(ex);
                        }
                    }
                    else
                    {
                        try
                        {
                            switch (objwarrant.WarrantType)
                            {
                                case WarrantType.Search:
                                    warrantTypeName = "Searh Warrant";
                                    break;
                                case WarrantType.Arrest:
                                    warrantTypeName = "Arrest Warrant";
                                    break;
                                case WarrantType.PickupOrder:
                                    warrantTypeName = "Juvenile Pickup Order";
                                    break;
                                case WarrantType.RPO:
                                    warrantTypeName = "Risk Protection Order";
                                    break;
                                case WarrantType.CBS:
                                    warrantTypeName = "Compel Blood Screening";
                                    break;
                                case WarrantType.CivilForfeiture:
                                    warrantTypeName = "Civil Forfeiture";
                                    break;
                                default:
                                    break;
                            }

                        }
                        catch (Exception ex)
                        {
                            Exceptions.LogException(ex);
                        }
                    }

                    try
                    {
                        FileInfo oldImage = new FileInfo(imgPath);
                        if (oldImage.Exists)
                        {
                            try
                            {
                                oldImage.Delete();
                            }
                            catch (Exception ex)
                            {
                                Exceptions.LogException(ex);
                            }
                        }
                        int portalId = 0;
                        if (portal != null)
                            portalId = portal.PortalId;
                        string fromaddress = "webhelp@jud12.flcourts.org";
                        string toaddress = UserController.GetUserById(portalId, objwarrant.CreatedByUserID).Email;
                        string subject = warrantTypeName + " Submission Accepted";
                        string body = "The " + warrantTypeName + " submission [" + warrantTitle + "] has been signed.";
                        Mail.SendEmail(fromaddress, toaddress, subject, body);
                    }
                    catch (Exception ex)
                    {
                        returnString += "0|The " + warrantTypeName + " was approved, but an error occurred sending the email messages.";
                        Exceptions.LogException(ex);
                    }
                }
                else
                {
                    WebAnnotationViewer1.ClearAnnotations();
                    returnString = "0|" + warrantTypeName + " could not be found. Please try again.";
                }
            }
            catch (Exception ex)
            {
                WebAnnotationViewer1.ClearAnnotations();
                returnString = "-1|" + ex.Message + "|" + ex.StackTrace.ToString();
                Exceptions.LogException(ex);
            }
            return returnString;
        }

        [RemoteInvokable]
        public string CancelWarrant(string enc)
        {
            string returnString = "2|default";
            try
            {
                WebAnnotationViewer1.ClearAnnotations();
                if (string.IsNullOrEmpty(objUser.Username))
                {
                    returnString = "0|Your session has expired. Please log in and try again.";
                    return returnString;
                }
                Int32.TryParse(encryptor.QueryStringDecode(enc, objUser.Username), out warrantId);
                CancelCheckout(true);
            }
            catch (Exception ex)
            {
                WebAnnotationViewer1.ClearAnnotations();
                returnString = "-1|" + ex.Message + "|" + ex.StackTrace.ToString();
                Exceptions.LogException(ex);
            }
            return returnString;
        }

        [RemoteInvokable]
        public string RejectWarrant(string enc, string rejecttest, string moduleId)
        {
            string returnString = "2|default";
            TabModuleId = Int32.Parse(moduleId);
            InitializeProperties();
            try
            {
                WebAnnotationViewer1.ClearAnnotations();
                if (string.IsNullOrEmpty(objUser.Username))
                {
                    returnString = "0|Your session has expired. Please log in and try again.";
                    return returnString;
                }
                Int32.TryParse(encryptor.QueryStringDecode(enc, objUser.Username), out warrantId);
                var ctl = new WarrantController();
                Warrant objwarrant = ctl.GetWarrant(warrantId);
                string warrantTypeName = "Warrant";
                if (objwarrant != null)
                {
                    switch (objwarrant.WarrantType)
                    {
                        case WarrantType.Search:
                            warrantTypeName = "Searh Warrant";
                            break;
                        case WarrantType.Arrest:
                            warrantTypeName = "Arrest Warrant";
                            break;
                        case WarrantType.PickupOrder:
                            warrantTypeName = "Juvenile Pickup Order";
                            break;
                        case WarrantType.RPO:
                            warrantTypeName = "Risk Protection Order";
                            break;
                        case WarrantType.CBS:
                            warrantTypeName = "Compel Blood Screening";
                            break;
                        case WarrantType.CivilForfeiture:
                            warrantTypeName = "Civil Forfeiture";
                            break;
                        default:
                            break;
                    }
                    int portalId = 0;
                    if (portal != null)
                        portalId = portal.PortalId;
                    string warrantTitle = objwarrant.Title;
                    objwarrant.ReviewedByJudgeUserID = objUser.UserID;
                    objwarrant.Status = WarrantStatus.Rejected;
                    objwarrant.ReviewedDate = DateTime.Now;
                    ctl.UpdateWarrant(objwarrant);

                    try
                    {
                        if (objwarrant.WarrantType == WarrantType.RPO)
                        {
                            SendRPORejectionNotifications(objwarrant, rejecttest);
                        }

                        string fromaddress = "webhelp@jud12.flcourts.org";
                        string toaddress = UserController.GetUserById(portalId, objwarrant.CreatedByUserID).Email;
                        string subject = warrantTypeName + " Submission Rejected";

                        string body = "The " + warrantTypeName + " submission [" + warrantTitle + "] was rejected for the following reason: " + rejecttest;
                        Mail.SendEmail(fromaddress, toaddress, subject, body);
                    }
                    catch (Exception ex)
                    {
                        returnString += "0|The " + warrantTypeName + " was rejected, but an error occurred sending the email messages.";
                        Exceptions.LogException(ex);
                    }
                }
                else
                    returnString = "0|" + warrantTypeName + " could not be updated. Please try again.";
            }
            catch (Exception ex)
            {
                WebAnnotationViewer1.ClearAnnotations();
                returnString = "-1|" + ex.Message + "|" + ex.StackTrace.ToString();
                Exceptions.LogException(ex);
            }
            return returnString;
        }

        [RemoteInvokable]
        public void RemoteChangeAnnoText(string newText)
        {
            if (WebAnnotationViewer1.Annotations.SelectedAnnotations.Count > 0)
            {
                AnnotationUI rawAnno = WebAnnotationViewer1.Annotations.SelectedAnnotations[0];

                if (rawAnno is TextAnnotation text)
                {
                    text.Text = newText;
                    text.AllowEditing = false;
                }
                if (rawAnno is RectangleAnnotation rect)
                    rect.Fill = new AnnotationBrush(Color.Blue);
                WebAnnotationViewer1.UpdateAnnotations();
                WebAnnotationViewer1.UpdateClient();
            }
        }

        [RemoteInvokable]
        public void RemoteCreateText(string aText, int locX, int locY, int aWidth, int aHeight)
        {
            int imageWidth = WebAnnotationViewer1.Image.Width;
            int fontsize = (int)(imageWidth * 0.017);
            AnnotationFont font = new AnnotationFont("Times New Roman", fontsize);
            TextAnnotation tAnno = new TextAnnotation
            {
                Location = new PointF(Convert.ToSingle(locX), Convert.ToSingle(locY)),
                // tAnno.Size = New SizeF(CSng(aWidth), CSng(aHeight))
                Size = GetBoxSize(aText, fontsize, imageWidth),
                Text = aText,
                Name = "CustomTextAnnotation",
                Outline = new AnnotationPen(Color.Transparent, 1),
                Fill = new AnnotationBrush(Color.Transparent),
                Font = font
            };
            if (WebAnnotationViewer1.Annotations.Layers.Count == 0)
                WebAnnotationViewer1.Annotations.Layers.Add(new LayerAnnotation());

            if (WebAnnotationViewer1.Annotations.CurrentLayer == null)
                WebAnnotationViewer1.Annotations.CurrentLayer = WebAnnotationViewer1.Annotations.Layers[0];
            WebAnnotationViewer1.Annotations.CurrentLayer.Items.Add(tAnno);
            WebAnnotationViewer1.UpdateAnnotations();
        }




        [RemoteInvokable]
        public void InsertTextAnnotation(string stampText)
        {
            AnnotationUI annotationToRemove = null;
            PointF location = new PointF();
            bool foundAnnotation = false;
            foreach (AnnotationUI i in WebAnnotationViewer1.Annotations.SelectedAnnotations)
            {
                if (i.Name == "DefaultPerscheduleStamp")
                {
                    annotationToRemove = i;
                    location = i.Location;
                    foundAnnotation = true;
                    break;
                }
            }
            if (foundAnnotation & stampText != "")
            {
                int resWidth = (int)WebAnnotationViewer1.Image.Resolution.X;
                WebAnnotationViewer1.Annotations.CurrentLayer.Items.Remove(annotationToRemove);
                WebAnnotationViewer1.Annotations.CurrentLayer.Items.Add(CreateStamp(location, stampText, resWidth));
                WebAnnotationViewer1.UpdateAnnotations();
            }
        }

        [RemoteInvokable]
        public void InsertDateAnnotation(string dateText)
        {
            AnnotationUI annotationToRemove = null;
            PointF location = new PointF();
            bool foundAnnotation = false;
            foreach (AnnotationUI i in WebAnnotationViewer1.Annotations.SelectedAnnotations)
            {
                if (i.Name == "DefaultDateStamp")
                {
                    annotationToRemove = i;
                    location = i.Location;
                    foundAnnotation = true;
                    break;
                }
            }
            if (foundAnnotation & !string.IsNullOrEmpty(dateText))
            {
                WebAnnotationViewer1.Annotations.CurrentLayer.Items.Remove(annotationToRemove);
                WebAnnotationViewer1.Annotations.CurrentLayer.Items.Add(CreateDateStamp(location, dateText));
                WebAnnotationViewer1.UpdateAnnotations();
            }
        }

        [RemoteInvokable]
        public void RemoteReplaceImage(string singleUrl)
        {
            AtalaImage temp = new AtalaImage(MapPath(ImageCache + singleUrl));
            string url = this.WebAnnotationViewer1.ImageUrl;
            string path = MapPath(url);
            int frame = this.WebAnnotationViewer1.CurrentPage - 1;
            ImageProcessing.SaveChanges(temp, path, frame);
            this.WebAnnotationViewer1.OpenUrl(url, frame);
            WebAnnotationViewer1.UpdateClient();
        }

        private void InitializeDefaultAnnotations(Judge judge, string username, int imageWidth)
        {
            string filePath = MapPath("images/perschedule.png");
            string checkMarkPath = MapPath("images/check.png");
            WebAnnotationViewer1.Annotations.DefaultAnnotations.Add(Annotations.MyHighlighter());
            WebAnnotationViewer1.Annotations.DefaultAnnotations.Add(Annotations.MyFreehand());
            WebAnnotationViewer1.Annotations.DefaultAnnotations.Add(Annotations.MyRedaction());
            WebAnnotationViewer1.Annotations.DefaultAnnotations.Add(Annotations.MyText(imageWidth));
            WebAnnotationViewer1.Annotations.DefaultAnnotations.Add(Annotations.MyCheckStamp(checkMarkPath, imageWidth));
            WebAnnotationViewer1.Annotations.DefaultAnnotations.Add(Annotations.MyInitialStamp(judge.Initial, imageWidth));
            WebAnnotationViewer1.Annotations.DefaultAnnotations.Add(Annotations.MySignatureStamp(judge.Signature, imageWidth));
            WebAnnotationViewer1.Annotations.DefaultAnnotations.Add(Annotations.MyDate(_isRPO, imageWidth));
            WebAnnotationViewer1.Annotations.DefaultAnnotations.Add(Annotations.MyPerschedule(filePath, imageWidth));
        }

        private TextAnnotation CreateStamp(PointF location, string stampText, int resolution)
        {
            TextAnnotation stampAnn = new TextAnnotation(stampText)
            {
                Visible = true,
                Font = new AnnotationFont("Times New Roman", Convert.ToInt32(resolution / 6.5), true, false, false, false),
                AutoSize = false,
                CanResize = true,
                Size = new SizeF(GetWidthOfString(stampText) + 30, 60),
                Location = location
            };
            return stampAnn;
        }

        private TextAnnotation CreateDateStamp(PointF location, string stampText)
        {

            var res = WebAnnotationViewer1.Image.Resolution;
            double xres = res.X;
            float fSize = 0;
            if (xres > 0)
                fSize = System.Convert.ToSingle(xres / 7.5);
            TextAnnotation stampAnn = new TextAnnotation(stampText)
            {
                Visible = true,
                Font = new AnnotationFont("Times New Roman", fSize, true, false, false, false),
                AutoSize = false,
                Size = new SizeF(GetWidthOfString(stampText, (float)(fSize * 1.2)), (float)(fSize * 1.5)),
                CanResize = true,
                Location = location
            };
            return stampAnn;
        }

        private float GetWidthOfString(string str, float fsize)
        {
            Bitmap objBitmap = new Bitmap(500, 200);
            Graphics objGraphics = Graphics.FromImage(objBitmap);
            SizeF stringSize = objGraphics.MeasureString(str, new Font("Times New Roman", fsize));
            objBitmap.Dispose();
            objGraphics.Dispose();
            return stringSize.Width;
        }

        private float GetWidthOfString(string str)
        {
            Bitmap objBitmap = new Bitmap(500, 200);
            Graphics objGraphics = Graphics.FromImage(objBitmap);
            SizeF stringSize = objGraphics.MeasureString(str, new Font("Times New Roman", 30));
            objBitmap.Dispose();
            objGraphics.Dispose();
            return stringSize.Width;
        }

        private SizeF GetBoxSize(string str, int fontsize, int ImageWidth)
        {
            int maxBoxSize = (int)(ImageWidth * 0.75);
            Bitmap objBitmap = new Bitmap(500, 200);
            Graphics objGraphics = Graphics.FromImage(objBitmap);
            SizeF stringSize = objGraphics.MeasureString(str, new Font("Times New Roman", fontsize));
            if (stringSize.Width > maxBoxSize)
            {
                float rows = (float)(Math.Ceiling(stringSize.Width / maxBoxSize));
                stringSize.Width = maxBoxSize;
                stringSize.Height = stringSize.Height * rows + 30;
            }
            stringSize.Width += 30;
            stringSize.Height += 20;
            objBitmap.Dispose();
            objGraphics.Dispose();
            return stringSize;
        }

        [RemoteInvokable]
        public void RemoteDeleteImage()
        {
            string url = this.WebAnnotationViewer1.ImageUrl;
            string path = MapPath(url);
            int frame = this.WebAnnotationViewer1.CurrentPage - 1;
            PageManipulation.RemovePageAndSave(path, frame);
            this.WebAnnotationViewer1.OpenUrl(url, frame);
        }

        [RemoteInvokable]
        public string RemoteInsertPage()
        {
            string url = this.WebAnnotationViewer1.ImageUrl;
            string path = MapPath(url);
            int frame = WebAnnotationViewer1.Annotations.Layers.Count;
            PageManipulation.InsertPageAndSave(path, frame);
            this.WebAnnotationViewer1.OpenUrl(url, frame);
            WebAnnotationViewer1.UpdateClient();
            InsertLayer();
            return WebAnnotationViewer1.ImageUrl;
        }

        [RemoteInvokable]
        public void InsertLayer()
        {
            WebAnnotationViewer1.Annotations.Layers.Add(new LayerAnnotation());
            WebAnnotationViewer1.UpdateAnnotations();
        }
    }
}